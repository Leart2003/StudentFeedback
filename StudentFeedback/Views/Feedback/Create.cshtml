@model StudentFeedback.Models.Feedback

@{
    ViewData["Title"] = "Give Feedback";
    var subjects = (SelectList)ViewBag.Subjects;
}
<select asp-for="SubjectId" asp-items="subjects" class="form-select">
<div class="mb-3">
    <label asp-for="Rating" class="form-label d-block"></label>
    @foreach (var option in Html.GetEnumSelectList<StudentFeedback.Models.Sentiment>())
    {
        <div class="form-check">
            <input class="form-check-input" type="radio" name="Rating"
                   id="rating-@option.Value" value="@option.Value"
                   checked="@(Model.Rating.HasValue && ((int)Model.Rating.Value).ToString() == option.Value)" />
            <label class="form-check-label" for="rating-@option.Value">@option.Text</label>
        </div>
    }
    <span asp-validation-for="Rating" class="text-danger"></span>
</div>
</select>